APP_NAME="3dPlateBuilder.com"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.3dplatebuilder.com

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.3dplatebuilder.com
MAIL_PORT=465
MAIL_USERNAME=noreply@3dplatebuilder.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@3dplatebuilder.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where portal notices to you go
PORTAL_ADMIN_EMAIL=hello@3dplatebuilder.com

# Stripe: a RESTRICTED key (rk_...) from the 3DPlateBuilder.com account, never the PlateBoss one.
# Sandbox now, live later. Keys live only in this file on the server, never in GitHub.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Price ids (not secret). These are the 3DPlateBuilder.com sandbox ones; swap for live ids at launch.
STRIPE_PRICE_STARTER=price_1USHukGs95yU4LbXl4qwz6zL
STRIPE_PRICE_PRO=price_1USHurGs95yU4LbXc6quvyyH
